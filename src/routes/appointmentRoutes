const express = require("express");
const router = express.Router();

const appointmentController = require("../controllers/appointmentController");
const { protect } = require("../middleware/authMiddleware");
const { authorize } = require("../middleware/roleMiddleware"); // adjust name if different
const {
  bookAppointmentValidation,
  updateStatusValidation,
  getAppointmentsValidation,
  validate,
} = require("../validations/appointmentValidation");

// All routes require authentication
router.use(protect);

// Book appointment (patients only)
router.post(
  "/",
  authorize("patient"),
  bookAppointmentValidation,
  validate,
  appointmentController.bookAppointment
);

// Get my appointments (patient or doctor)
router.get(
  "/",
  getAppointmentsValidation,
  validate,
  appointmentController.getMyAppointments
);

// Get single appointment
router.get(
  "/:id",
  appointmentController.getAppointmentById
);

// Update status (doctor/admin mainly, patients only cancel)
router.patch(
  "/:id/status",
  updateStatusValidation,
  validate,
  appointmentController.updateAppointmentStatus
);

// Convenience cancel endpoint
router.patch(
  "/:id/cancel",
  appointmentController.cancelAppointment
);

module.exports = router;
